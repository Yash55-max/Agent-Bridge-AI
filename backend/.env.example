APP_NAME=AgentBridge AI API
APP_VERSION=0.1.0
CORS_ORIGINS=["http://localhost:3000"]

# Amazon Bedrock / AWS credentials
## LLM provider selection (groq)
LLM_PROVIDER=groq

## Groq API (LLM provider)
# Set `GROQ_API_KEY` to use Groq. Example: GROQ_API_KEY=gsks_...
GROQ_API_KEY=
# Optional: override Groq API URL (default is https://api.groq.com/openai/v1/chat/completions)
GROQ_API_URL=
# Optional: Groq model used for generation
GROQ_MODEL=llama-3.1-8b-instant
